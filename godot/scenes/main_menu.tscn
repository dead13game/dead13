[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.06, 0.06, 0.09, 1)

[node name="CenterBox" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MenuPanel" type="VBoxContainer" parent="CenterBox"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="CenterBox/MenuPanel"]
unique_name_in_owner = true
layout_mode = 2
text = "亡命十三街"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 56

[node name="ModeLabel" type="Label" parent="CenterBox/MenuPanel"]
unique_name_in_owner = true
layout_mode = 2
text = "Godot 移植版"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20

[node name="Spacer" type="Control" parent="CenterBox/MenuPanel"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2

[node name="Buttons" type="VBoxContainer" parent="CenterBox/MenuPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="NormalButton" type="Button" parent="CenterBox/MenuPanel/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(280, 48)
text = "经典模式"

[node name="FootballButton" type="Button" parent="CenterBox/MenuPanel/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(280, 48)
text = "足球模式"

[node name="SoloButton" type="Button" parent="CenterBox/MenuPanel/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(280, 48)
text = "单人模式（待移植）"

[node name="SimuniverseButton" type="Button" parent="CenterBox/MenuPanel/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(280, 48)
text = "模拟宇宙（待移植）"

[node name="RulesButton" type="Button" parent="CenterBox/MenuPanel/Buttons"]
layout_mode = 2
custom_minimum_size = Vector2(280, 48)
text = "规则说明"

[connection signal="pressed" from="CenterBox/MenuPanel/Buttons/NormalButton" to="." method="_on_normal_pressed"]
[connection signal="pressed" from="CenterBox/MenuPanel/Buttons/FootballButton" to="." method="_on_football_pressed"]
[connection signal="pressed" from="CenterBox/MenuPanel/Buttons/SoloButton" to="." method="_on_solo_pressed"]
[connection signal="pressed" from="CenterBox/MenuPanel/Buttons/SimuniverseButton" to="." method="_on_simuniverse_pressed"]
[connection signal="pressed" from="CenterBox/MenuPanel/Buttons/RulesButton" to="." method="_on_rules_pressed"]
